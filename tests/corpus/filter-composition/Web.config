<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <authentication mode="Windows" />
    <authorization>
      <allow users="*" />
    </authorization>
  </system.web>
  <location path="Locked">
    <system.web>
      <authorization>
          <deny users="?" />
          <allow users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
