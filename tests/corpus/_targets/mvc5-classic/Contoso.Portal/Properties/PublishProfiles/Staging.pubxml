<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Staging</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://staging.contoso.test/portal?launch=1</SiteUrlToLaunchAfterPublish>
    <MSDeployServiceURL>https://deploy-stg.contoso.test:8172/msdeploy.axd</MSDeployServiceURL>
    <DeployIisAppPath>Portal-Staging</DeployIisAppPath>
    <UserName>deploy-stg-user</UserName>
  </PropertyGroup>
</Project>
