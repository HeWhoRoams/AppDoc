<?xml version="1.0"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="PilotFlag" value="1" xdt:Transform="InsertAfter(/configuration/appSettings/add[@key='Environment'])" />
  </appSettings>
  <system.web>
    <authorization xdt:Transform="Replace" xdt:Locator="XPath(/configuration/system.web/authorization)">
      <allow roles="PortalAdmins" />
      <deny users="*" />
    </authorization>
  </system.web>
</configuration>
