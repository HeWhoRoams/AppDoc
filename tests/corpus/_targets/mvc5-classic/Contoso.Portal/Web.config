<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Environment" value="Base" />
    <add key="PortalTitle" value="Contoso Portal" />
    <add key="ReportsShare" value="\\files.contoso.test\reports" />
    <add key="MailRelay" value="mail.contoso.test" />
    <add key="MailRelay" value="mail2.contoso.test" />
    <add key="TesterIds" value="E1001,E1002,E1003" />
    <add key="PilotUserIds" value="E2001,E2002" />
    <add key="ReviewerIds" value="E3001,E3002,E3003,E3004" />
    <add key="AuditorIds" value="E4001,E4002" />
    <add key="SupportIds" value="E5001,E5002,E5003" />
    <add key="ApproverIds" value="E6001,E6002" />
    <add key="ExemptIds" value="E7001,E7002,E7003" />
    <add key="CertificateExpiryYear" value="2031" />
    <add key="ReportServerPassword" value="not-a-real-password-0002" />
    <add key="ApiAccessToken" value="not-a-real-token-0003" />
  </appSettings>
  <connectionStrings>
    <add name="PortalDb" connectionString="Server=sql01.contoso.test;Database=Portal;User ID=portal_app;Password=not-a-real-password-0004;" providerName="System.Data.SqlClient" />
    <add name="ReportsDb" connectionString="Server=sql02.contoso.test;Database=Reports;Integrated Security=SSPI;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <authentication mode="Windows" />
    <authorization>
      <allow roles="PortalUsers,PortalAdmins" />
      <allow users="CONTOSO\pat,CONTOSO\sam" />
      <deny users="*" />
    </authorization>
    <machineKey validationKey="0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF" decryptionKey="FEDCBA9876543210FEDCBA9876543210" validation="SHA1" decryption="AES" />
    <customErrors mode="Off" />
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <httpCookies requireSSL="false" httpOnlyCookies="true" />
    <trace enabled="true" localOnly="true" />
    <sessionState mode="InProc" />
  </system.web>
  <system.serviceModel>
    <client>
      <endpoint address="https://svcuser:not-a-real-pw@reports.contoso.test:8443/ReportService.svc?token=abc#frag" binding="basicHttpBinding" contract="Contoso.Portal.IReportService" name="ReportEndpoint" />
    </client>
  </system.serviceModel>
  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Scripts">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="OldPrintJobs">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Archive2019">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Health">
    <system.web>
      <authorization>
        <allow users="?" />
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Info/Welcome">
    <system.web>
      <authorization>
        <allow users="?" />
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Account/Login">
    <system.web>
      <authorization>
        <allow users="?" />
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Unsubscribe.aspx">
    <system.web>
      <authorization>
        <allow users="?" />
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Account">
    <system.web>
      <authorization>
        <deny users="?" />
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Profile">
    <system.web>
      <authorization>
        <deny users="?" />
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Orders">
    <system.web>
      <authorization>
        <deny users="?" />
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Dashboard">
    <system.web>
      <authorization>
        <deny users="?" />
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Billing">
    <system.web>
      <authorization>
        <allow roles="PortalAdmins,FinanceStaff,Auditors" />
        <allow users="CONTOSO\pat,CONTOSO\sam,contoso\PAT" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Admin/Tools">
    <system.web>
      <authorization>
        <allow roles="PortalAdmins,FinanceStaff,Auditors" />
        <allow users="CONTOSO\pat,CONTOSO\sam,contoso\PAT" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Billing/Refunds">
    <system.web>
      <authorization>
        <allow roles="PortalAdmins,FinanceStaff,Auditors" />
        <allow users="CONTOSO\pat,CONTOSO\sam,contoso\PAT" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
