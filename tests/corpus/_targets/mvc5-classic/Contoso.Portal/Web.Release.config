<?xml version="1.0"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <appSettings>
    <add key="Environment" value="Release" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="TesterIds" value="E1001" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
  <connectionStrings>
    <add name="PortalDb" connectionString="Server=sql-prod.contoso.test;Database=Portal;User ID=portal_prod;Password=not-a-real-password-0006;" providerName="System.Data.SqlClient" xdt:Transform="Replace" xdt:Locator="Match(name)" />
  </connectionStrings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors defaultRedirect="~/Error" mode="RemoteOnly" xdt:Transform="SetAttributes" />
    <httpCookies requireSSL="true" httpOnlyCookies="false" xdt:Transform="SetAttributes(requireSSL)" />
    <trace xdt:Transform="RemoveAll" />
    <authorization xdt:Transform="Replace">
      <deny users="?" />
      <allow users="*" />
    </authorization>
  </system.web>
  <location path="Billing" xdt:Locator="Match(path)">
    <system.web>
      <authorization>
        <allow roles="Interns" xdt:Transform="Insert" />
      </authorization>
    </system.web>
  </location>
</configuration>
