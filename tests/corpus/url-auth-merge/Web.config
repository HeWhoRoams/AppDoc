<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <authentication mode="Windows" />
    <authorization>
      <allow roles="Staff" />
      <deny users="*" />
    </authorization>
  </system.web>
  <location path="FallThrough">
    <system.web>
      <authorization>
          <allow roles="Admins" />
      </authorization>
    </system.web>
  </location>
  <location path="Wins">
    <system.web>
      <authorization>
          <allow users="*" />
          <deny users="?" />
      </authorization>
    </system.web>
  </location>
  <location path="Cleared">
    <system.web>
      <authorization>
          <clear />
      </authorization>
    </system.web>
  </location>
  <location path="Removed">
    <system.web>
      <authorization>
          <remove users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Named">
    <system.web>
      <authorization>
          <allow users="CONTOSO\pat" />
          <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Tie">
    <system.web>
      <authorization>
          <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Tie">
    <system.web>
      <authorization>
          <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Verbs">
    <system.web>
      <authorization>
          <deny verbs="POST" users="*" />
          <allow users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
