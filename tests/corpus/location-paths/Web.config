<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <authentication mode="Windows" />
    <authorization>
      <allow users="*" />
    </authorization>
  </system.web>
  <location path=".">
    <system.web>
      <authorization>
          <allow roles="dot" />
      </authorization>
    </system.web>
  </location>
  <location path="">
    <system.web>
      <authorization>
          <allow roles="empty" />
      </authorization>
    </system.web>
  </location>
  <location>
    <system.web>
      <authorization>
          <allow roles="absent" />
      </authorization>
    </system.web>
  </location>
  <location path="~/Admin">
    <system.web>
      <authorization>
          <allow roles="tilde" />
      </authorization>
    </system.web>
  </location>
  <location path="ADMINTOOLS">
    <system.web>
      <authorization>
          <allow roles="mixedcase" />
      </authorization>
    </system.web>
  </location>
  <location path="Locked" allowOverride="false">
    <system.web>
      <authorization>
          <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Private" inheritInChildApplications="false">
    <system.web>
      <authorization>
          <deny users="?" />
      </authorization>
    </system.web>
  </location>
  <location path="Legacy">
    <system.webServer>
      <security>
        <authorization>
          <add accessType="Allow" users="*" />
        </authorization>
      </security>
    </system.webServer>
  </location>
</configuration>
