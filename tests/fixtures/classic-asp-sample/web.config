<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="HelpDeskMain"
         connectionString="Provider=SQLOLEDB;Data Source=FIXTURE-SERVER;Initial Catalog=FIXTURE_DB;User Id=fakeuser;Password=fakepass"
         providerName="SqlClient" />
    <add name="HelpDeskReport"
         connectionString="Provider=SQLOLEDB;Data Source=FIXTURE-SERVER;Initial Catalog=FIXTURE_DB;User Id=fakeuser;Password=fakepass"
         providerName="SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="HelpDesk.LogLevel" value="Warning" />
  </appSettings>
  <system.web>
    <httpRuntime requestValidationMode="2.0" />
  </system.web>
</configuration>
