<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="HelpDeskMain"
         connectionString="Server=FIXTURE-SERVER;Database=FIXTURE_DB;User Id=fakeuser;Password=FakeP@ss123;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="HelpDesk.LogLevel" value="Warning" />
    <add key="HelpDesk.SupportApiUrl" value="https://fixture.internal/itsm/api" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime requestValidationMode="2.0" />
    <authentication mode="Forms">
      <forms requireSSL="true" />
    </authentication>
    <authorization>
      <allow roles="Support" />
      <deny users="*" />
    </authorization>
  </system.web>
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
</configuration>
