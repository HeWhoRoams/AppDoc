{
  "version": "1.0.0",
  "defaults": {
    "includeDocs": false,
    "includeAppDocTools": false,
    "includeFixtures": false,
    "includeTests": false,
    "excludePatterns": [
      "(?:^|\\\\)\\.git(?:\\\\|$)",
