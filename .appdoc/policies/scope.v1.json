{
  "version": "1.0.0",
  "defaults": {
    "includeDocs": false,
    "includeAppDocTools": false,
    "includeFixtures": false,
    "includeTests": false,
    "excludePatterns": [
      "(?:^|\\\\)\\.git(?:\\\\|$)",
      "(?:^|\\\\)node_modules(?:\\\\|$)",
      "(?:^|\\\\)bower_components(?:\\\\|$)",
      "(?:^|[\\/])\.git(?:[\\/]|$)",
      "(?:^|[\\/])node_modules(?:[\\/]|$)",
      "(?:^|[\\/])bower_components(?:[\\/]|$)",
      "(?:^|[\\/])bin(?:[\\/]|$)",
      "(?:^|[\\/])obj(?:[\\/]|$)",
      "(?:^|[\\/])target(?:[\\/]|$)",
      "(?:^|[\\/])build(?:[\\/]|$)",
      "(?:^|[\\/])dist(?:[\\/]|$)",
      "(?:^|[\\/])__pycache__(?:[\\/]|$)",
      "(?:^|[\\/])\.venv(?:[\\/]|$)",
      "(?:^|[\\/])\.tox(?:[\\/]|$)",
      "(?:^|[\\/])docuwriter(?:[\\/]|$)",
      "(?:^|[\\/])generated-doc(?:[\\/]|$)",
      "(?:^|[\\/])(?:test|tests|spec|specs)(?:[\\/]|$)",
      "(?:^|[\\/])[^\\/]*(?:\.Tests?|Tests?|Testing)(?:[\\/]|$)",
      "(?:^|[\\/])__tests__(?:[\\/]|$)",
      "(?:^|[\\/])__mocks__(?:[\\/]|$)",
      "(?:^|[\\/])(?:fixture|fixtures)(?:[\\/]|$)",
      "(?:^|[\\/])(?:mock|mocks)(?:[\\/]|$)",
      "(?:^|[\\/])(?:sample|samples|example|examples)(?:[\\/]|$)"
    "default": {},
    "overview": {},
    "start-here": {},
    "api-inventory": {},
    "data-model": {},
    "config-catalog": {},
    "test-catalog": {
      "includeTests": true,
      "includeFixtures": false
    },
    "build-cookbook": {},
    "dependencies-catalog": {},
    "debt-register": {},
    "dependency-graph": {}
  }
}
