{
  "version": "1.0.0",
  "defaults": {
    "includeDocs": false,
    "includeAppDocTools": false,
    "includeFixtures": false,
    "includeTests": false,
    "excludePatterns": [
      "(?:^|\\\\)\\.git(?:\\\\|$)",
      "(?:^|\\\\)node_modules(?:\\\\|$)",
      "(?:^|\\\\)bower_components(?:\\\\|$)",
      "(?:^|\\\\)bin(?:\\\\|$)",
      "(?:^|\\\\)obj(?:\\\\|$)",
      "(?:^|\\\\)target(?:\\\\|$)",
      "(?:^|\\\\)build(?:\\\\|$)",
      "(?:^|\\\\)dist(?:\\\\|$)",
      "(?:^|\\\\)__pycache__(?:\\\\|$)",
      "(?:^|\\\\)\\.venv(?:\\\\|$)",
      "(?:^|\\\\)\\.tox(?:\\\\|$)",
      "(?:^|\\\\)\\.appdoc(?:\\\\|$)",
      "(?:^|\\\\)docuwriter(?:\\\\|$)",
      "(?:^|\\\\)docs?(?:\\\\|$)",
      "(?:^|\\\\)generated-doc(?:\\\\|$)",
      "(?:^|\\\\)(?:test|tests|spec|specs)(?:\\\\|$)",
      "(?:^|\\\\)[^\\\\]*(?:\\.Tests?|Tests?|Testing)(?:\\\\|$)",
      "(?:^|\\\\)__tests__(?:\\\\|$)",
      "(?:^|\\\\)__mocks__(?:\\\\|$)",
      "(?:^|\\\\)(?:fixture|fixtures)(?:\\\\|$)",
      "(?:^|\\\\)(?:mock|mocks)(?:\\\\|$)"
    ]
  },
  "artifactProfiles": {
    "default": {},
    "overview": {
      "includeTests": false,
      "includeFixtures": false,
      "patternSets": {
        "source": [
          "*.cs",
          "*.js",
          "*.ts",
          "*.py",
          "*.java"
        ]
      }
    },
    "start-here": {
      "includeTests": false,
      "includeFixtures": false,
      "patternSets": {
        "source": [
          "*.cs",
          "*.js",
          "*.ts",
          "*.py",
          "*.java"
        ]
      }
    },
    "api-inventory": {
      "includeTests": false,
      "includeFixtures": false,
      "patternSets": {
        "source": [
          "*.js",
          "*.ts",
          "*.cs",
          "*.py",
          "*.java",
          "*.svc",
          "*.asmx"
        ]
      }
    },
    "data-model": {
      "includeTests": false,
      "includeFixtures": false
    },
    "config-catalog": {
      "includeTests": false,
      "includeFixtures": false,
      "excludePatterns": [
        "(?i)(?:^|\\\\)(?!application(?:-[A-Za-z0-9_-]+)?\\.properties$)[A-Za-z0-9_-]+\\.properties$"
      ]
    },
    "test-catalog": {
      "includeTests": true,
      "includeFixtures": false,
      "patternSets": {
        "source": [
          "*.test.js",
          "*.test.ts",
          "*.spec.js",
          "*.spec.ts",
          "*Test.cs",
          "*Tests.cs",
          "test_*.py",
          "*_test.py"
        ],
        "signalSource": [
          "*.cs",
          "*.ts",
          "*.js",
          "*.py",
          "*.java",
          "*.go",
          "*.feature"
        ],
        "signalProjects": [
          "*.csproj",
          "*.vbproj",
          "*.fsproj"
        ]
      }
    },
    "build-cookbook": {
      "includeTests": false,
      "includeFixtures": false
    },
    "dependencies-catalog": {
      "includeTests": false,
      "includeFixtures": false,
      "patternSets": {
        "signals": [
          "*.csproj",
          "*.vbproj",
          "packages.config",
          "package.json",
          "pom.xml",
          "build.gradle",
          "build.gradle.kts",
          "requirements.txt",
          "Pipfile",
          "poetry.lock",
          "*.nuspec"
        ]
      }
    },
    "debt-register": {
      "includeTests": false,
      "includeFixtures": false,
      "patternSets": {
        "source": [
          "*.js",
          "*.ts",
          "*.cs",
          "*.py",
          "*.java"
        ]
      }
    },
    "dependency-graph": {
      "includeTests": false,
      "includeFixtures": false,
      "patternSets": {
        "source": [
          "*.js",
          "*.ts",
          "*.jsx",
          "*.tsx"
        ]
      }
    },
    "external-call": {
      "includeTests": false,
      "includeFixtures": false,
      "patternSets": {
        "source": [
          "*.ts",
          "*.js",
          "*.cs",
          "*.py",
          "*.java"
        ]
      }
    }
  }
}
